<!DOCTYPE html>
<html lang="fr">
<%- include('partials/head') %>
<body>
  <%- include('partials/nav') %>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-left">
      <p class="hero-eyebrow">Conformité · Meublés de tourisme · France</p>
      <h1>Ne manquez plus<br>aucune <em>règle</em>,<br>aucun délai.</h1>
      <p class="hero-desc">Chaque commune de France superpose ses propres règles : plafonds 90/120 jours, Declaloc, DPE, délibérations en cours. <%= site.name %> suit tout, automatiquement, sur l'ensemble de votre portefeuille.</p>
      <div class="hero-actions">
        <a href="/tarifs" class="btn-primary">Voir les tarifs &rarr;</a>
        <a href="#fonctionnalites" class="btn-ghost">Voir les fonctionnalités</a>
      </div>
      <div class="hero-stats">
        <div>
          <div class="hero-stat-value" data-count="60" data-suffix="+">60+</div>
          <div class="hero-stat-label">lots gérés en moyenne</div>
        </div>
        <div>
          <div class="hero-stat-value" data-count="20" data-suffix=" k&euro;">20 k&euro;</div>
          <div class="hero-stat-label">amende maximum par infraction</div>
        </div>
        <div>
          <div class="hero-stat-value" data-count="6">6</div>
          <div class="hero-stat-label">communes couvertes en live</div>
        </div>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-card">
        <div class="hero-card-label">DéclaLoc &mdash; Registre National</div>
        <div class="hero-card-num">FR-2026-01147-MARS-3E</div>
        <div class="hero-card-row">
          <span class="hero-card-row-label">Commune</span>
          <span class="hero-card-row-val">Marseille, 13006</span>
        </div>
        <div class="hero-card-row">
          <span class="hero-card-row-label">Résidence principale</span>
          <span class="hero-card-row-val">12 rue de la République</span>
        </div>
        <div class="hero-card-row">
          <span class="hero-card-row-label">Jours loués (2026)</span>
          <span class="hero-card-row-val">67 / 120</span>
        </div>
        <div class="hero-card-row">
          <span class="hero-card-row-label">DPE</span>
          <span class="hero-card-row-val">C &mdash; Valide</span>
        </div>
        <div class="hero-card-status">
          <span class="status-ok">&#10003; Conforme</span>
          <span class="status-days">53 jours restants avant plafond</span>
        </div>
        <div class="fines-pill">
          <div class="fine-chip">
            <span class="fine-chip-amt">&euro;10k</span>
            <span class="fine-chip-lbl">Non-enregist.</span>
          </div>
          <div class="fine-chip">
            <span class="fine-chip-amt">&euro;20k</span>
            <span class="fine-chip-lbl">Fausse décl.</span>
          </div>
          <div class="fine-chip">
            <span class="fine-chip-amt">&euro;15k</span>
            <span class="fine-chip-lbl">Quota excédé</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar" data-stagger>
    <div class="trust-item">
      <div class="trust-icon">DL</div>
      Téléservice Declaloc intégré
